# Copy this file to ".env" and fill in your IBM Quantum credentials.
# ".env" is git-ignored and is read automatically when running on IBM hardware
# (acrpq quantum ... --mode ibm_runtime|ibm_real). Never commit your real token.

# Free API token from https://quantum.ibm.com (Account page).
QISKIT_IBM_TOKEN=

# Optional: IBM Runtime channel (defaults to the qiskit-ibm-runtime default).
# QISKIT_IBM_CHANNEL=ibm_quantum_platform

# Optional: instance (hub/group/project or CRN), if your account needs one.
# QISKIT_IBM_INSTANCE=

# Free API token from https://cloud.dwavesys.com/leap (Dashboard). Enables the
# real D-Wave quantum annealer (acrpq quantum --dwave --mode qpu). Without it,
# the token-free simulated-annealing sampler (--mode neal) still works.
DWAVE_API_TOKEN=
